<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Content retrieval (foc providers), Arkiv queries, and Haven-AOL canister calls. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hedged fetch tunes its delay on metered vs unmetered connections. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Media3 keeps audio playing while the screen is off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Video and PDF viewers need a real screen; phones and tablets only. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".HavenApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        tools:replace="android:dataExtractionRules,android:fullBackupContent"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Haven">

        <provider
            android:name=".EarlyCrashProvider"
            android:authorities="${applicationId}.earlycrash"
            android:exported="false"
            android:initOrder="100" />

        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:theme="@style/Theme.Haven" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Haven"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              WalletConnect return leg. The wallet app sends the signed response back to
              haven://connect; without this filter the user is left staring at their wallet
              after approving, and the pending request times out.
              Must match WalletConfig.redirectUrl / Core.Model.AppMetaData.redirect.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="connect"
                    android:scheme="haven" />
            </intent-filter>
        </activity>

        <!--
          WorkManager is initialised on demand by the cache/eviction jobs rather than at
          startup, to keep cold start inside the 2.0s budget (requirements §6).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

    <!--
      Resolving the "Open with…" chooser for an exported file (FR-FILE-2). Without a
      <queries> block, package visibility on API 30+ hides every handler and the chooser
      comes back empty.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

</manifest>
